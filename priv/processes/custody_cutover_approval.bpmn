<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   id="Definitions_custody_cutover_approval"
                   targetNamespace="https://github.com/lukegalea/ash_compliance/processes">
  <bpmn2:process id="Process_custody_cutover_approval" name="Custody or authority cutover approval" isExecutable="true">
    <bpmn2:startEvent id="Start" name="Start">
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:serviceTask id="Service_1" name="Open the cutover record">
      <bpmn2:extensionElements><ash:taskConfig action="compliance.open_record"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Service_3" name="Attach the comparison result">
      <bpmn2:extensionElements><ash:taskConfig action="compliance.attach_evidence"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:outgoing>Flow_6</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:userTask id="Task_5" name="Approve the cutover">
      <bpmn2:extensionElements><ash:taskConfig><ash:candidates><ash:candidate kind="role" of="approver"/></ash:candidates><ash:exclusions><ash:exclusion who="subject.requester_id"/></ash:exclusions><ash:outcomes><ash:outcome name="approved"/><ash:outcome name="rejected"/></ash:outcomes><ash:timers><ash:timer kind="remind" hours="56"/><ash:timer kind="escalate" hours="112"/><ash:timer kind="expire" days="7"/></ash:timers></ash:taskConfig></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_6</bpmn2:incoming>
      <bpmn2:outgoing>Flow_8</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_7" name="Approve the cutover: approved?" default="Flow_9">
      <bpmn2:incoming>Flow_8</bpmn2:incoming>
      <bpmn2:outgoing>Flow_9</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_11</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End_rejected" name="Rejected or expired">
      <bpmn2:extensionElements><ash:taskConfig outcome="rejected"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_9</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:businessRuleTask id="Decision_10" name="Check separation of duties">
      <bpmn2:extensionElements><ash:decision ref="compliance.separation_of_duties" binding="latest"/><ash:inputs><ash:input name="requester" from="subject.requester_id"/><ash:input name="approver" from="subject.approver_id"/><ash:input name="delegators" from="subject.delegator_ids"/></ash:inputs><ash:promote><ash:signal name="separation" from="outcome" required="true"/></ash:promote></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_11</bpmn2:incoming>
      <bpmn2:outgoing>Flow_13</bpmn2:outgoing>
    </bpmn2:businessRuleTask>
    <bpmn2:exclusiveGateway id="Gateway_12" name="Approve the cutover: different people?" default="Flow_14">
      <bpmn2:incoming>Flow_13</bpmn2:incoming>
      <bpmn2:outgoing>Flow_14</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_16</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End_refused" name="Refused: approver is the requester">
      <bpmn2:extensionElements><ash:taskConfig outcome="refused"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_14</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:serviceTask id="Service_15" name="Apply the approved cutover">
      <bpmn2:extensionElements><ash:taskConfig action="compliance.apply_decision"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_16</bpmn2:incoming>
      <bpmn2:outgoing>Flow_18</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Service_17" name="Record completion evidence">
      <bpmn2:extensionElements><ash:taskConfig action="compliance.record_completion"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_18</bpmn2:incoming>
      <bpmn2:outgoing>Flow_19</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:endEvent id="End_completed" name="Completed">
      <bpmn2:extensionElements><ash:taskConfig outcome="completed"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_19</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Start" targetRef="Service_1"/>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Service_1" targetRef="Service_3"/>
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Service_3" targetRef="Task_5"/>
    <bpmn2:sequenceFlow id="Flow_8" sourceRef="Task_5" targetRef="Gateway_7"/>
    <bpmn2:sequenceFlow id="Flow_9" sourceRef="Gateway_7" targetRef="End_rejected"/>
    <bpmn2:sequenceFlow id="Flow_11" sourceRef="Gateway_7" targetRef="Decision_10">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">task.outcome = "approved"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_13" sourceRef="Decision_10" targetRef="Gateway_12"/>
    <bpmn2:sequenceFlow id="Flow_14" sourceRef="Gateway_12" targetRef="End_refused"/>
    <bpmn2:sequenceFlow id="Flow_16" sourceRef="Gateway_12" targetRef="Service_15">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">routing.separation = "permit"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_18" sourceRef="Service_15" targetRef="Service_17"/>
    <bpmn2:sequenceFlow id="Flow_19" sourceRef="Service_17" targetRef="End_completed"/>
  </bpmn2:process>
</bpmn2:definitions>
