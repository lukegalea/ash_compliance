<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   id="Definitions_policy_review_acknowledgement"
                   targetNamespace="https://github.com/lukegalea/ash_compliance/processes">
  <bpmn2:process id="Process_policy_review_acknowledgement" name="Policy review and staff acknowledgement" isExecutable="true">
    <bpmn2:startEvent id="Start" name="Start">
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="Task_1" name="Review the policy set">
      <bpmn2:extensionElements><ash:taskConfig><ash:candidates><ash:candidate kind="role" of="policy_owner"/></ash:candidates><ash:outcomes><ash:outcome name="reviewed"/><ash:outcome name="not_completed"/></ash:outcomes><ash:timers><ash:timer kind="remind" hours="360"/><ash:timer kind="escalate" hours="720"/><ash:timer kind="expire" days="45"/></ash:timers></ash:taskConfig></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_3" name="Review the policy set: finished?" default="Flow_5">
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_7</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End_not_completed" name="Not completed">
      <bpmn2:extensionElements><ash:taskConfig outcome="not_completed"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_5</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:userTask id="Task_6" name="Approve the policy set">
      <bpmn2:extensionElements><ash:taskConfig><ash:candidates><ash:candidate kind="role" of="approver"/></ash:candidates><ash:exclusions><ash:exclusion who="subject.requester_id"/></ash:exclusions><ash:outcomes><ash:outcome name="approved"/><ash:outcome name="rejected"/></ash:outcomes><ash:timers><ash:timer kind="remind" hours="360"/><ash:timer kind="escalate" hours="720"/><ash:timer kind="expire" days="45"/></ash:timers></ash:taskConfig></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_7</bpmn2:incoming>
      <bpmn2:outgoing>Flow_9</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_8" name="Approve the policy set: approved?" default="Flow_10">
      <bpmn2:incoming>Flow_9</bpmn2:incoming>
      <bpmn2:outgoing>Flow_10</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_12</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End_rejected" name="Rejected or expired">
      <bpmn2:extensionElements><ash:taskConfig outcome="rejected"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_10</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:businessRuleTask id="Decision_11" name="Check separation of duties">
      <bpmn2:extensionElements><ash:decision ref="compliance.separation_of_duties" binding="latest"/><ash:inputs><ash:input name="requester" from="subject.requester_id"/><ash:input name="approver" from="subject.approver_id"/><ash:input name="delegators" from="subject.delegator_ids"/></ash:inputs><ash:promote><ash:signal name="separation" from="outcome" required="true"/></ash:promote></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_12</bpmn2:incoming>
      <bpmn2:outgoing>Flow_14</bpmn2:outgoing>
    </bpmn2:businessRuleTask>
    <bpmn2:exclusiveGateway id="Gateway_13" name="Approve the policy set: different people?" default="Flow_15">
      <bpmn2:incoming>Flow_14</bpmn2:incoming>
      <bpmn2:outgoing>Flow_15</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_17</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End_refused" name="Refused: approver is the requester">
      <bpmn2:extensionElements><ash:taskConfig outcome="refused"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_15</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:serviceTask id="Service_16" name="Collect staff acknowledgements">
      <bpmn2:extensionElements><ash:taskConfig action="compliance.attach_evidence"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_17</bpmn2:incoming>
      <bpmn2:outgoing>Flow_19</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="Service_18" name="Record completion evidence">
      <bpmn2:extensionElements><ash:taskConfig action="compliance.record_completion"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_19</bpmn2:incoming>
      <bpmn2:outgoing>Flow_20</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:endEvent id="End_completed" name="Completed">
      <bpmn2:extensionElements><ash:taskConfig outcome="completed"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_20</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Start" targetRef="Task_1"/>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Task_1" targetRef="Gateway_3"/>
    <bpmn2:sequenceFlow id="Flow_5" sourceRef="Gateway_3" targetRef="End_not_completed"/>
    <bpmn2:sequenceFlow id="Flow_7" sourceRef="Gateway_3" targetRef="Task_6">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">task.outcome = "reviewed"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_9" sourceRef="Task_6" targetRef="Gateway_8"/>
    <bpmn2:sequenceFlow id="Flow_10" sourceRef="Gateway_8" targetRef="End_rejected"/>
    <bpmn2:sequenceFlow id="Flow_12" sourceRef="Gateway_8" targetRef="Decision_11">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">task.outcome = "approved"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_14" sourceRef="Decision_11" targetRef="Gateway_13"/>
    <bpmn2:sequenceFlow id="Flow_15" sourceRef="Gateway_13" targetRef="End_refused"/>
    <bpmn2:sequenceFlow id="Flow_17" sourceRef="Gateway_13" targetRef="Service_16">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">routing.separation = "permit"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_19" sourceRef="Service_16" targetRef="Service_18"/>
    <bpmn2:sequenceFlow id="Flow_20" sourceRef="Service_18" targetRef="End_completed"/>
  </bpmn2:process>
</bpmn2:definitions>
