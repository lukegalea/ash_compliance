<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   id="Definitions_incident_response"
                   targetNamespace="https://github.com/lukegalea/ash_compliance/processes">
  <bpmn2:process id="Process_incident_response" name="Incident record, response and post-incident review" isExecutable="true">
    <bpmn2:startEvent id="Start" name="Start">
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:serviceTask id="Service_1" name="Open the incident record">
      <bpmn2:extensionElements><ash:taskConfig action="compliance.open_record"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:businessRuleTask id="Decision_3" name="Route by severity">
      <bpmn2:extensionElements><ash:decision ref="compliance.triage_routing" binding="latest"/><ash:inputs><ash:input name="severity" from="subject.severity"/></ash:inputs><ash:promote><ash:signal name="route" from="route" required="true"/></ash:promote></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:outgoing>Flow_6</bpmn2:outgoing>
    </bpmn2:businessRuleTask>
    <bpmn2:exclusiveGateway id="Gateway_5" name="Route" default="Flow_12">
      <bpmn2:incoming>Flow_6</bpmn2:incoming>
      <bpmn2:outgoing>Flow_7</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_9</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_12</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End_recorded_only" name="Recorded only, below the triage threshold">
      <bpmn2:extensionElements><ash:taskConfig outcome="recorded_only"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_7</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:serviceTask id="Service_8" name="Notify the owner role">
      <bpmn2:extensionElements><ash:taskConfig action="compliance.notify"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_9</bpmn2:incoming>
      <bpmn2:outgoing>Flow_11</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:userTask id="Task_10" name="Respond to the incident">
      <bpmn2:extensionElements><ash:taskConfig><ash:candidates><ash:candidate kind="role" of="incident_lead"/></ash:candidates><ash:outcomes><ash:outcome name="resolved"/><ash:outcome name="not_completed"/></ash:outcomes><ash:timers><ash:timer kind="remind" hours="112"/><ash:timer kind="escalate" hours="224"/><ash:timer kind="expire" days="14"/></ash:timers></ash:taskConfig></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_11</bpmn2:incoming>
      <bpmn2:incoming>Flow_12</bpmn2:incoming>
      <bpmn2:outgoing>Flow_14</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_13" name="Respond to the incident: finished?" default="Flow_15">
      <bpmn2:incoming>Flow_14</bpmn2:incoming>
      <bpmn2:outgoing>Flow_15</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_17</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End_not_completed" name="Not completed">
      <bpmn2:extensionElements><ash:taskConfig outcome="not_completed"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_15</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:userTask id="Task_16" name="Review the incident after resolution">
      <bpmn2:extensionElements><ash:taskConfig><ash:candidates><ash:candidate kind="role" of="security_reviewer"/></ash:candidates><ash:exclusions><ash:exclusion who="subject.requester_id"/></ash:exclusions><ash:outcomes><ash:outcome name="approved"/><ash:outcome name="rejected"/></ash:outcomes><ash:timers><ash:timer kind="remind" hours="112"/><ash:timer kind="escalate" hours="224"/><ash:timer kind="expire" days="14"/></ash:timers></ash:taskConfig></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_17</bpmn2:incoming>
      <bpmn2:outgoing>Flow_19</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_18" name="Review the incident after resolution: approved?" default="Flow_20">
      <bpmn2:incoming>Flow_19</bpmn2:incoming>
      <bpmn2:outgoing>Flow_20</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_22</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End_rejected" name="Rejected or expired">
      <bpmn2:extensionElements><ash:taskConfig outcome="rejected"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_20</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:businessRuleTask id="Decision_21" name="Check separation of duties">
      <bpmn2:extensionElements><ash:decision ref="compliance.separation_of_duties" binding="latest"/><ash:inputs><ash:input name="requester" from="subject.requester_id"/><ash:input name="approver" from="subject.approver_id"/><ash:input name="delegators" from="subject.delegator_ids"/></ash:inputs><ash:promote><ash:signal name="separation" from="outcome" required="true"/></ash:promote></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_22</bpmn2:incoming>
      <bpmn2:outgoing>Flow_24</bpmn2:outgoing>
    </bpmn2:businessRuleTask>
    <bpmn2:exclusiveGateway id="Gateway_23" name="Review the incident after resolution: different people?" default="Flow_25">
      <bpmn2:incoming>Flow_24</bpmn2:incoming>
      <bpmn2:outgoing>Flow_25</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_27</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:endEvent id="End_refused" name="Refused: approver is the requester">
      <bpmn2:extensionElements><ash:taskConfig outcome="refused"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_25</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:serviceTask id="Service_26" name="Record completion evidence">
      <bpmn2:extensionElements><ash:taskConfig action="compliance.record_completion"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_27</bpmn2:incoming>
      <bpmn2:outgoing>Flow_28</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:endEvent id="End_completed" name="Completed">
      <bpmn2:extensionElements><ash:taskConfig outcome="completed"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_28</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Start" targetRef="Service_1"/>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Service_1" targetRef="Decision_3"/>
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Decision_3" targetRef="Gateway_5"/>
    <bpmn2:sequenceFlow id="Flow_7" sourceRef="Gateway_5" targetRef="End_recorded_only">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">routing.route = "record_only"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_9" sourceRef="Gateway_5" targetRef="Service_8">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">routing.route = "urgent"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_11" sourceRef="Service_8" targetRef="Task_10"/>
    <bpmn2:sequenceFlow id="Flow_12" sourceRef="Gateway_5" targetRef="Task_10"/>
    <bpmn2:sequenceFlow id="Flow_14" sourceRef="Task_10" targetRef="Gateway_13"/>
    <bpmn2:sequenceFlow id="Flow_15" sourceRef="Gateway_13" targetRef="End_not_completed"/>
    <bpmn2:sequenceFlow id="Flow_17" sourceRef="Gateway_13" targetRef="Task_16">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">task.outcome = "resolved"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_19" sourceRef="Task_16" targetRef="Gateway_18"/>
    <bpmn2:sequenceFlow id="Flow_20" sourceRef="Gateway_18" targetRef="End_rejected"/>
    <bpmn2:sequenceFlow id="Flow_22" sourceRef="Gateway_18" targetRef="Decision_21">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">task.outcome = "approved"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_24" sourceRef="Decision_21" targetRef="Gateway_23"/>
    <bpmn2:sequenceFlow id="Flow_25" sourceRef="Gateway_23" targetRef="End_refused"/>
    <bpmn2:sequenceFlow id="Flow_27" sourceRef="Gateway_23" targetRef="Service_26">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="feel">routing.separation = "permit"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_28" sourceRef="Service_26" targetRef="End_completed"/>
  </bpmn2:process>
</bpmn2:definitions>
